{
  "name": "murry-ai",
  "version": "1.0.0",
  "description": "MurryAI — Agentic Proposal Intelligence Platform on Cloudflare",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "wrangler": "node ./node_modules/wrangler/bin/wrangler.js",
    "dev": "node ./node_modules/wrangler/bin/wrangler.js dev --local",
    "deploy": "node ./node_modules/wrangler/bin/wrangler.js deploy",
    "db:migrate": "node ./node_modules/wrangler/bin/wrangler.js d1 execute hello-ai --file=./migrations/001_init.sql",
    "db:migrate:remote": "node ./node_modules/wrangler/bin/wrangler.js d1 execute hello-ai --remote --file=./migrations/001_init.sql",
    "db:studio": "node ./node_modules/wrangler/bin/wrangler.js d1 studio hello-ai",
    "setup": "npm run db:migrate && echo 'Run: npm run wrangler -- secret put ANTHROPIC_API_KEY'",
    "setup:remote": "npm run db:migrate:remote && echo 'Run: npm run wrangler -- secret put ANTHROPIC_API_KEY'",
    "tail": "node ./node_modules/wrangler/bin/wrangler.js tail",
    "type-check": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260511.1",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
