{
  "name": "murry-ai",
  "version": "1.0.0",
  "description": "MurryAI — Agentic Proposal Intelligence Platform on Cloudflare",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute hello-ai --file=./migrations/001_init.sql",
    "db:migrate:remote": "wrangler d1 execute hello-ai --remote --file=./migrations/001_init.sql",
    "db:studio": "wrangler d1 studio hello-ai",
    "setup": "npm run db:migrate && echo 'Run: wrangler secret put ANTHROPIC_API_KEY'",
    "setup:remote": "npm run db:migrate:remote && echo 'Run: wrangler secret put ANTHROPIC_API_KEY'",
    "tail": "wrangler tail",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^3.105.0"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
